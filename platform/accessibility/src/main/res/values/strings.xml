<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shown in system accessibility settings. Not translated: it is the brand. -->
    <string name="accessibility_service_label" translatable="false">Babel</string>

    <!--
      The first copy a user reads about Babel, and it carries the privacy claim.
      Keep all three parts: what is read, that pictures may be taken, and that
      nothing is uploaded. The middle one was added when manga mode moved from
      MediaProjection to accessibility screenshots (ADR 009) — the system used
      to announce screen reading with its own dialog and recording indicator,
      and this sentence is now the only place the user is told.
    -->
    <string name="accessibility_service_description">Reads the text currently on screen so it can be translated in place. In manga mode it also takes pictures of the screen to read text inside images. Everything is translated on this device and is not uploaded.</string>


</resources>
