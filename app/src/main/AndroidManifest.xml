<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        One of two permissions Babel holds, and it buys two things, both of
        which the user has to ask for: remote translation, off until it is
        turned on and configured (ADR 010), and fetching the comic recogniser's
        weights, which happens only when someone presses the button (ADR 011).
        Everything else — screen reading, recognition, on-device translation,
        rendering — works without it and always has.

        The other is ACCESS_NETWORK_STATE, declared in :platform:capture beside
        the code that needs it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BabelApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Babel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Babel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Translation on and off without touching the accessibility service,
            which a force stop would take away (BabelTileService).
        -->
        <service
            android:name=".tile.BabelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
